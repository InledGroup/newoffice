---
/**
 * `/home` -- where work starts, in English.
 *
 * The app's own front door: create something, open a file, and pick up where
 * you left off. Everything it lists comes out of this browser's IndexedDB, so
 * the page stays out of search. The translated routes live in
 * src/pages/[locale]/home.astro.
 */
import AppLayout from '../layouts/AppLayout.astro';
import HomeBody from '../components/HomeBody.astro';
import { SITE_COPY } from '../i18n/site';

const locale = 'en';
const copy = SITE_COPY[locale];
---

<AppLayout title={copy.meta.homeTitle} current="home" locale={locale}>
  <HomeBody locale={locale} />

  <script>
    import '../scripts/home';
  </script>
</AppLayout>
